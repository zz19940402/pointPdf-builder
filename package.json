{
  "name": "pointpdf-dsh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness skill bundle for pointPdf-builder, a dependency-free static Chinese resume generator with five A4 templates.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "SKILL.md",
    "skills",
    "scripts",
    "templates",
    "shared",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "resume",
    "pdf",
    "skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
